{
  "name": "async-doctor",
  "version": "0.10.0",
  "description": "Static analysis CLI that detects sequential async bottlenecks in Node.js/TypeScript code.",
  "type": "module",
  "bin": {
    "async-doctor": "dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "async",
    "static-analysis",
    "performance",
    "typescript",
    "cli",
    "ts-morph",
    "lint",
    "promise"
  ],
  "author": "hhw12409",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhw12409/async-doctor.git"
  },
  "homepage": "https://github.com/hhw12409/async-doctor#readme",
  "bugs": {
    "url": "https://github.com/hhw12409/async-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
